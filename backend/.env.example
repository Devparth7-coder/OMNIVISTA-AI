# OMNIVISTA AI — environment configuration
# Copy to `.env` and adjust. Never commit real secrets.

# ---- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
APP_NAME=OMNIVISTA AI
MOCK_MODE=true            # run with zero external services/API keys

# ---- CORS (comma-separated) ---------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---- Provider selection (mock/* for out-of-the-box demo) -----------------------
LLM_PROVIDER=mock
VISION_PROVIDER=mock
EMBEDDING_PROVIDER=mock
VECTOR_DB_PROVIDER=memory
STORAGE_PROVIDER=local
TASK_QUEUE_PROVIDER=inline
RERANKER_PROVIDER=mock
OCR_PROVIDER=mock

# ---- External services (unused in mock mode) ----------------------------------
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# ---- Processing knobs -----------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
TEXT_CHUNK_CHARS=1400
TEXT_CHUNK_OVERLAP=160
TOP_K_CANDIDATES=30
TOP_K_FINAL=8
MAX_RETRIEVAL_ITERATIONS=3

# ---- Public URLs (frontend) ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Auth (future) -------------------------------------------------------------
JWT_SECRET=
