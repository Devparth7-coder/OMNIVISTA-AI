{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "omnivista",
  "comment": "Monorepo root. Deploy backend/ and frontend/ as two separate Vercel projects (omnivista-api, omnivista-web). See DEPLOYMENT.md.",
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 60, "memory": 1024 }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/next",
      "config": { "distDir": "frontend/.next" }
    }
  ]
}
